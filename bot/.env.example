# =====================================================================
#  workdays-bot — настройки (черновик .env)
#  cp .env.example .env && nano .env && chmod 600 .env
#  .env не коммитится (он в .gitignore) и не копируется в образ (.dockerignore)
# =====================================================================

# [!] Токен от @BotFather (/mybots → бот → API Token)
BOT_TOKEN=

# Telegram ID, кому можно менять отпуска (через запятую); пусто — всем
# Свой ID можно узнать у @userinfobot
ADMIN_IDS=

# Часовой пояс расчёта дат
TZ=Europe/Moscow

# Первый день цикла и сам цикл: N — ночь, D — день, O — выходной
SCHEDULE_START=2026-09-04
SCHEDULE_PATTERN=N,N,O,O,O,D,D,O

# На чьё упоминание в чате бот отвечает статусом
PERSON_TAG=@chepykella

# ---------- Сеть ----------
# Нужно, только если api.telegram.org недоступен с этого хоста (блокировка).
# На хосте за рубежом (например, VDS) оставь пустым.
#   BOT_PROXY=socks5://user:pass@host:1080   или   http://host:3128
BOT_PROXY=
# Собственное зеркало Bot API (reverse proxy на api.telegram.org)
TELEGRAM_API_URL=

# =====================================================================
#  PetWeb — переменные окружения (черновик .env)
#
#  1. Скопируй на сервер:   cp .env.example /opt/petweb/.env
#  2. Заполни значения ниже (пароли — свои, длинные).
#  3. Права только для владельца: chmod 600 /opt/petweb/.env
#  4. Применить:            cd /opt/petweb && docker compose up -d
#
#  .env НЕ хранится в git и НЕ перезаписывается CI — он живёт только на сервере.
#  Обязательные поля помечены [!] — без них docker compose не запустится.
# =====================================================================

# ---------- Общее ----------
DOMAIN=chepykella.ru
TZ=Europe/Moscow

# ---------- Grafana ----------
GRAFANA_ADMIN_USER=admin
# [!] Пароль admin. ВАЖНО: Grafana применяет его только при ПЕРВОМ запуске (пустой volume).
#     Если Grafana уже работает — поменяй пароль в её интерфейсе и впиши сюда тот же
#     (он нужен виджету Grafana на Homepage).
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# ---------- code-server (VS Code в браузере, https://code.chepykella.ru) ----------
# [!] Пароль входа
CODE_SERVER_PASSWORD=change-me-code-server
# От какого пользователя работает code-server; deploy.sh отдаёт ему файлы проекта
CODE_SERVER_UID=1000
CODE_SERVER_GID=1000

# ---------- Telegram-бот графика (workdays-bot) ----------
# Токен от @BotFather; пусто — бот не запускается, остальное работает
BOT_TOKEN=
# Telegram ID, кому можно менять отпуска (через запятую); пусто — всем
BOT_ADMIN_IDS=
SCHEDULE_START=2026-09-04
# Цикл смен: N — ночь, D — день, O — выходной
SCHEDULE_PATTERN=N,N,O,O,O,D,D,O
PERSON_TAG=@chepykella

# ---------- SSL (ручной выпуск ./cert.sh) ----------
CERT_EMAIL=DanilMkrtchian@gmail.com

# ---------- Homepage: ключи для виджетов (необязательно) ----------
# После заполнения раскомментируй соответствующий widget в HomeLab/HomePage/services.yaml
# Portainer → My account → Access tokens
PORTAINER_API_KEY=
# Proxmox → Datacenter → Permissions → API Tokens (роль PVEAuditor)
# формат пользователя: user@pam!tokenid
PROXMOX_API_USER=
PROXMOX_API_TOKEN=
# TrueNAS → Credentials → API Keys
TRUENAS_API_KEY=

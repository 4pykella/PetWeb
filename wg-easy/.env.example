# =====================================================================
#  wg-easy — настройки (черновик .env)
#  cp .env.example .env && nano .env && chmod 600 .env
# =====================================================================

# [!] Публичный IP или домен VDS — к нему подключаются клиенты
WG_HOST=88.218.68.236

# UDP-порт WireGuard. Если на VDS уже работает свой WireGuard на 51820 —
# остановить его (systemctl disable --now wg-quick@wg0) или взять другой порт
WG_PORT=51820

# [!] Админ веб-интерфейса. Применяется ТОЛЬКО при первом запуске.
#     После входа пароль можно стереть отсюда (дальше он хранится в базе wg-easy).
WG_ADMIN_USER=admin
WG_ADMIN_PASSWORD=change-me-long-password

# DNS для клиентов
WG_DNS=1.1.1.1,8.8.8.8

# true, если у VDS нет IPv6
WG_DISABLE_IPV6=false

# Где слушает веб-интерфейс: 127.0.0.1 — только через SSH-туннель (рекомендуется)
WG_UI_BIND=127.0.0.1

# ---------- Только для профиля https (Caddy) ----------
# Домен веб-интерфейса, A-запись → IP VDS. Пример: wg.chepykella.ru
WG_UI_DOMAIN=
ACME_EMAIL=
